<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/terminal_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_title"
            android:textColor="@color/terminal_green"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            style="@style/TerminalPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/today_total"
                style="@style/TerminalText.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/today_default" />

            <TextView
                android:id="@+id/month_total"
                style="@style/TerminalText.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/month_default"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            style="@style/TerminalText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_graph_title"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            style="@style/TerminalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_graph_hint"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            style="@style/TerminalPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/trend_chart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pending_status"
            style="@style/TerminalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pending_default"
            android:background="@drawable/terminal_border"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/actions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_add_expense"
                    style="@style/TerminalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/add_expense" />

                <Button
                    android:id="@+id/btn_expense_list"
                    style="@style/TerminalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/view_expenses" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_refresh"
                    style="@style/TerminalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/dashboard_refresh" />

                <Button
                    android:id="@+id/btn_sync"
                    style="@style/TerminalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/sync_pending" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_add_savings"
                    style="@style/TerminalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/dashboard_add_savings" />

                <Button
                    android:id="@+id/btn_view_savings"
                    style="@style/TerminalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/dashboard_view_savings" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_health"
                    style="@style/TerminalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/dashboard_health" />

                <Button
                    android:id="@+id/btn_hacker_mode"
                    style="@style/TerminalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/dashboard_hacker" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_settings"
            style="@style/TerminalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_button" />

        <Button
            android:id="@+id/btn_logout"
            style="@style/TerminalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/logout_button"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
