<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_black"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvBootSequence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        style="@style/TerminalText.Large"
        android:gravity="center"
        android:text="@string/boot_sequence" />

    <TextView
        android:id="@+id/tvLoadingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvBootSequence"
        android:layout_marginTop="24dp"
        style="@style/TerminalText"
        android:gravity="center"
        android:text="[░░░░░░░░░░]" />

</RelativeLayout>
