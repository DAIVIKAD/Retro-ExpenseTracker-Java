<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/terminal_border"
    android:padding="12dp">

    <TextView
        android:id="@+id/saving_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/terminal_green"
        android:textStyle="bold"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/saving_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/terminal_green_dim"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_edit_saving"
            style="@style/TerminalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/edit_label" />

        <Button
            android:id="@+id/btn_delete_saving"
            style="@style/TerminalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/delete_label" />
    </LinearLayout>

</LinearLayout>

