<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed for Firebase / network calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RetroExpense"
        tools:targetApi="31">

        <!-- Launcher / Splash (your retro boot screen) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login screen (Firebase auth) -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- Dashboard (main app) -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- Add Expense screen -->
        <activity
            android:name=".AddExpenseActivity"
            android:exported="false" />

        <!-- Expense list screen -->
        <activity
            android:name=".ExpenseListActivity"
            android:exported="false" />

        <!-- PIN lock screen -->
        <activity
            android:name=".PinLockActivity"
            android:exported="false" />

        <!-- Settings screen -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Savings screens -->
        <activity
            android:name=".AddSavingActivity"
            android:exported="false" />
        <activity
            android:name=".SavingsListActivity"
            android:exported="false" />

        <!-- Hacker mode screen (if you have it) -->
        <activity
            android:name=".HackerModeActivity"
            android:exported="false"
            tools:ignore="MissingClass" />

    </application>

</manifest>
